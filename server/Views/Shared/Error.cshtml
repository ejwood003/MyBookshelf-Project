@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<h1>Something went wrong</h1>
<p>The shelf is still there — the page just failed to load. Try again in a moment.</p>

@if (Model.ShowRequestId)
{
    <p><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
}

<p><a href="/">Back to My Books</a></p>
